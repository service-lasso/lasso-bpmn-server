{
  "$schema": "https://service-lasso.dev/schemas/service.schema.json",
  "id": "bpmn-server",
  "name": "BPMN Server",
  "description": "Release-backed BPMN Server web app and API for local business-process modeling and execution.",
  "version": "1.0.0",
  "enabled": true,
  "status": "30",
  "icon": "pi pi-globe",
  "servicelocation": 10,
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-bpmn-server",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-bpmn-server-1.0.0-win32.zip",
        "archiveType": "zip",
        "command": "./src/lasso-bpmn-server.cjs",
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      },
      "linux": {
        "assetName": "lasso-bpmn-server-1.0.0-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./src/lasso-bpmn-server.cjs",
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      },
      "darwin": {
        "assetName": "lasso-bpmn-server-1.0.0-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./src/lasso-bpmn-server.cjs",
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      }
    }
  },
  "execconfig": {
    "debuglog": true,
    "execservice": {
      "id": "@node"
    },
    "execcwd": "${SERVICE_ARTIFACT_ROOT}",
    "datapath": "./processes",
    "commandline": {
      "win32": "${SERVICE_ARTIFACT_ROOT}/src/lasso-bpmn-server.cjs",
      "linux": "${SERVICE_ARTIFACT_ROOT}/src/lasso-bpmn-server.cjs",
      "darwin": "${SERVICE_ARTIFACT_ROOT}/src/lasso-bpmn-server.cjs",
      "default": "${SERVICE_ARTIFACT_ROOT}/src/lasso-bpmn-server.cjs"
    },
    "env": {
      "NODE_ENV": "production",
      "PORT": "${SERVICE_PORT}",
      "BPMN_PORT": "${SERVICE_PORT}",
      "BPMN_URL": "http://127.0.0.1:${SERVICE_PORT}",
      "API_KEY": "typerefinery",
      "SESSION_SECRET": "typerefinery",
      "MONGO_DB_NAME": "bpmn",
      "MONGO_DB_URL": "mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@127.0.0.1:${MONGO_PORT}?retryWrites=true&w=majority&directConnection=true",
      "DEFINITIONS_PATH": "${SERVICE_DATA_PATH}"
    },
    "globalenv": {
      "BPMN_URL": "http://127.0.0.1:${SERVICE_PORT}",
      "BPMN_PORT": "${SERVICE_PORT}"
    },
    "serviceport": 8190,
    "depend_on": [
      "@node",
      "mongo"
    ]
  },
  "healthchecks": [
    {
      "id": "http-ready",
      "type": "http",
      "url": "http://127.0.0.1:${SERVICE_PORT}/healthcheck",
      "expected_status": 200,
      "retries": 180,
      "interval": 500
    }
  ],
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest"
  }
}
